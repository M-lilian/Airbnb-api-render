generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HOST
  GUEST
}

enum ListingType {
  APARTMENT
  HOUSE
  VILLA
  CABIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  username         String    @unique
  phone            String
  password         String    // Secured by bcrypt
  role             Role      @default(GUEST)
  resetToken       String?   
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile          Profile?
  listings         Listing[]
  bookings         Booking[]
  reviews          Review[]  // 💅 NEW: Added for Lesson 6
  avatar           String?
  avatarPublicId   String?

  // 💅 NEW: Lesson 6 Performance Indexes
  @@index([name])
  @@index([role])
}

model Profile {
  id      Int     @id @default(autoincrement())
  bio     String?
  website String?
  country String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int     @unique
}

model Listing {
  id            Int            @id @default(autoincrement())
  title         String
  description   String
  location      String
  pricePerNight Float
  guests        Int
  type          ListingType
  amenities     String[]
  rating        Float?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  hostId        Int
  host          User           @relation(fields: [hostId], references: [id], onDelete: Cascade)

  bookings      Booking[]
  reviews       Review[]       // 💅 NEW: Added for Lesson 6
  photos        ListingPhoto[]

  // 💅 NEW: Lesson 6 Performance Indexes 
  @@index([location])
  @@index([pricePerNight])
  @@index([type])
  @@index([hostId])
  @@index([type, location]) 
}

model Booking {
  id         Int           @id @default(autoincrement())
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float         // Keeping your 'totalPrice' instead of 'total' so old code doesn't break
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  guestId    Int
  guest      User          @relation(fields: [guestId], references: [id], onDelete: Cascade)

  listingId  Int
  listing    Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // 💅 NEW: Lesson 6 Performance Indexes
  @@index([guestId])
  @@index([listingId])
  @@index([status])
  @@index([listingId, checkIn, checkOut]) 
}

// 💅 NEW MODEL: Added for Lesson 6
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  guestId   Int      // Using guestId to match your existing naming style
  guest     User     @relation(fields: [guestId], references: [id], onDelete: Cascade)

  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([listingId])
}

model ListingPhoto {
  id        Int     @id @default(autoincrement())
  url       String
  publicId  String
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}